{
  "name": "office-speaker",
  "productName": "Office Speaker",
  "version": "0.1.0",
  "description": "Turns this computer into a Spotify Connect speaker anyone on the network can play to.",
  "main": "src/main.js",
  "private": true,
  "license": "MIT",
  "author": "Juan Quenga",
  "scripts": {
    "engine": "node scripts/build-engine.mjs",
    "ui": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "node scripts/build-engine.mjs && vite build && electron .",
    "dist:mac": "vite build && electron-builder --mac --universal --publish never",
    "dist:win": "vite build && electron-builder --win --x64 --publish never",
    "dist:linux": "node scripts/build-engine.mjs && vite build && electron-builder --linux AppImage --publish never"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.6"
  },
  "build": {
    "appId": "app.officespeaker.desktop",
    "productName": "Office Speaker",
    "files": [
      "src/**/*",
      "dist-renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "engine/dist",
        "to": "engine",
        "filter": [
          "speaker-engine*"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.music",
      "identity": "-",
      "x64ArchFiles": "Contents/Resources/engine/*",
      "extendInfo": {
        "LSUIElement": true,
        "NSLocalNetworkUsageDescription": "Office Speaker announces itself on your network so people can pick it in their Spotify app.",
        "NSBonjourServices": [
          "_spotify-connect._tcp"
        ]
      }
    },
    "dmg": {
      "title": "Office Speaker"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    },
    "linux": {
      "category": "Audio"
    }
  }
}
